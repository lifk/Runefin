{
  "name": "runefin-decky",
  "version": "0.1.0",
  "description": "Open and control Runefin from the Steam Quick Access Menu",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "18.3.3",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "overrides": {
      "glob@>=9.0.0 <=14.0.1": "14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
